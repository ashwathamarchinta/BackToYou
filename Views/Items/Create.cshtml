@model BackToYou.Models.ViewModels.ItemCreateViewModel
@{
    bool isLost = Model.Type == BackToYou.Models.Entities.ItemType.Lost;
    ViewData["Title"] = isLost ? "Report a Lost Item" : "Report a Found Item";
}

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <!-- Header -->
            <div class="text-center mb-4">
                <span class="hero-eyebrow mb-2">CAMPUS REGISTRY</span>
                <h1 class="page-title mb-2">@(isLost ? "Report a Lost Item" : "Report a Found Item")</h1>
                <p class="section-subtitle">Tell us a few details so our university community can help identify it.</p>
            </div>

            <!-- Form Card -->
            <div class="card p-4 p-md-5 rounded-4 border shadow-sm bg-white">
                <form asp-action="Create" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger rounded-3 small p-3 mb-4" role="alert"></div>

                    <!-- Section: Type Switcher -->
                    <div class="mb-4">
                        <label class="form-label d-block text-muted small text-uppercase fw-bold" style="letter-spacing: 0.06em;">1. Report Type</label>
                        <div class="row g-2">
                            <div class="col-6">
                                <input type="radio" class="btn-check" asp-for="Type" id="typeLost" value="Lost" autocomplete="off">
                                <label class="btn btn-outline-danger w-100 py-3 rounded-4 d-flex flex-column align-items-center gap-1" for="typeLost">
                                    <i class="bi bi-exclamation-circle fs-4"></i>
                                    <span class="fw-bold">I Lost Something</span>
                                </label>
                            </div>
                            <div class="col-6">
                                <input type="radio" class="btn-check" asp-for="Type" id="typeFound" value="Found" autocomplete="off">
                                <label class="btn btn-outline-success w-100 py-3 rounded-4 d-flex flex-column align-items-center gap-1" for="typeFound">
                                    <i class="bi bi-box2-heart fs-4"></i>
                                    <span class="fw-bold">I Found Something</span>
                                </label>
                            </div>
                        </div>
                        <span asp-validation-for="Type" class="text-danger small"></span>
                    </div>

                    <!-- Section: Item Information -->
                    <div class="mb-4 pt-3 border-top">
                        <label class="form-label d-block text-muted small text-uppercase fw-bold mb-3" style="letter-spacing: 0.06em;">2. Item Information</label>

                        <div class="mb-3">
                            <label asp-for="Title" class="form-label">Item Title or Name</label>
                            <input asp-for="Title" class="form-control" placeholder="e.g. Casio fx-991CW Calculator, Blue Osprey Backpack..." />
                            <span asp-validation-for="Title" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="CategoryId" class="form-label">Category</label>
                            <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
                                <option value="">-- Choose Category --</option>
                            </select>
                            <span asp-validation-for="CategoryId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Description" class="form-label">Distinctive Details</label>
                            <textarea asp-for="Description" rows="4" class="form-control" placeholder="Describe color, brand, stickers, scratches, or special markings that identify it..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Section: Where & When -->
                    <div class="mb-4 pt-3 border-top">
                        <label class="form-label d-block text-muted small text-uppercase fw-bold mb-3" style="letter-spacing: 0.06em;">3. Where &amp; When</label>

                        <div class="row g-3">
                            <div class="col-md-7">
                                <label asp-for="Location" class="form-label">Campus Location</label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-geo-alt"></i></span>
                                    <input asp-for="Location" class="form-control border-start-0" placeholder="e.g. Library 2nd Floor, Desk 14..." />
                                </div>
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>

                            <div class="col-md-5">
                                <label asp-for="EventDate" class="form-label">Date</label>
                                <input asp-for="EventDate" class="form-control" type="date" />
                                <span asp-validation-for="EventDate" class="text-danger small"></span>
                            </div>
                        </div>
                    </div>

                    <!-- Section: Photo Evidence -->
                    <div class="mb-4 pt-3 border-top">
                        <label class="form-label d-block text-muted small text-uppercase fw-bold mb-2" style="letter-spacing: 0.06em;">4. Photo Evidence (Recommended)</label>
                        <div class="file-dropzone position-relative">
                            <i class="bi bi-cloud-arrow-up display-5 text-primary mb-2 d-block"></i>
                            <div class="fw-semibold text-dark mb-1">Click or drag an image here to upload</div>
                            <div class="small text-muted mb-2">Supported: JPG, PNG, WEBP (Max 5MB)</div>
                            <input asp-for="ImageFile" class="form-control" type="file" accept="image/*" />
                        </div>
                        <span asp-validation-for="ImageFile" class="text-danger small"></span>
                    </div>

                    <!-- Actions -->
                    <div class="d-flex gap-3 pt-3">
                        <button type="submit" class="btn btn-primary flex-fill py-3 rounded-pill fw-semibold">
                            <i class="bi bi-send-check me-1"></i> Publish Campus Report
                        </button>
                        <a asp-action="Index" class="btn btn-secondary px-4 py-3 rounded-pill">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
