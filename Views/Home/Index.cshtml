@model IEnumerable<BackToYou.Models.Entities.Item>
@{
    ViewData["Title"] = "Campus Lost & Found Portal";
    var categories = ViewBag.Categories as IEnumerable<BackToYou.Models.ViewModels.CategorySummaryViewModel>;
}

<!-- ==================== HERO SECTION ==================== -->
<section class="hero-section">
    <div class="hero-glow-1"></div>
    <div class="hero-glow-2"></div>
    <div class="hero-grid-overlay"></div>

    <div class="container position-relative" style="z-index: 2;">
        <div class="row align-items-center gy-5">
            <!-- Left Column: Copy & Actions -->
            <div class="col-lg-7">
                <div class="hero-eyebrow">
                    <i class="bi bi-arrow-repeat text-info"></i>
                    <span>LOST &amp; FOUND, SIMPLIFIED</span>
                </div>

                <h1 class="hero-headline">
                    Some things are meant<br />
                    to find their <span class="text-highlight">way back</span>.
                </h1>

                <p class="hero-subtext">
                    Report what you've lost, share what you've found, and help belongings make their way BackToYou.
                </p>

                <!-- Action Buttons -->
                <div class="d-flex flex-wrap gap-3 mb-4">
                    <a asp-controller="Items" asp-action="Create" asp-route-type="Lost" class="btn btn-hero-primary">
                        <i class="bi bi-exclamation-circle text-danger"></i> Report a Lost Item
                    </a>
                    <a asp-controller="Items" asp-action="Create" asp-route-type="Found" class="btn btn-hero-secondary">
                        <i class="bi bi-box2-heart text-success"></i> I Found Something
                    </a>
                </div>

                <!-- Prominent Search Bar -->
                <form asp-controller="Items" asp-action="Index" method="get" class="hero-search-box">
                    <i class="bi bi-search text-muted fs-6 ms-1"></i>
                    <input type="text" name="searchTerm" placeholder="Search for wallets, ID cards, headphones, keys..." aria-label="Search items" />
                    <button type="submit" class="hero-search-btn">
                        <span>Search</span>
                        <i class="bi bi-arrow-right"></i>
                    </button>
                </form>
            </div>

            <!-- Right Column: Layered Floating Miniature Cards (Desktop) -->
            <div class="col-lg-5 d-none d-lg-block">
                <div class="hero-visual-stage">
                    <!-- Miniature Card 1: Lost Leather Wallet -->
                    <div class="floating-card floating-card-1">
                        <div class="floating-card-icon bg-lost">
                            <i class="bi bi-wallet2"></i>
                        </div>
                        <div>
                            <div class="floating-card-title">Leather Wallet</div>
                            <div class="floating-card-meta"><i class="bi bi-geo-alt me-1"></i>Library 2nd Floor</div>
                        </div>
                    </div>

                    <!-- Miniature Card 2: Found Earbuds -->
                    <div class="floating-card floating-card-2">
                        <div class="floating-card-icon bg-found">
                            <i class="bi bi-headphones"></i>
                        </div>
                        <div>
                            <div class="floating-card-title">AirPods Pro Case</div>
                            <div class="floating-card-meta"><i class="bi bi-geo-alt me-1"></i>Sports Ground</div>
                        </div>
                    </div>

                    <!-- Miniature Card 3: Lost ID Card -->
                    <div class="floating-card floating-card-3">
                        <div class="floating-card-icon bg-lost">
                            <i class="bi bi-person-badge"></i>
                        </div>
                        <div>
                            <div class="floating-card-title">Student ID Card</div>
                            <div class="floating-card-meta"><i class="bi bi-geo-alt me-1"></i>Cafeteria Block B</div>
                        </div>
                    </div>

                    <!-- Miniature Card 4: Found Backpack -->
                    <div class="floating-card floating-card-4">
                        <div class="floating-card-icon bg-found">
                            <i class="bi bi-backpack"></i>
                        </div>
                        <div>
                            <div class="floating-card-title">Blue Laptop Bag</div>
                            <div class="floating-card-meta"><i class="bi bi-geo-alt me-1"></i>Computer Lab 3</div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== ELEGANT METRICS STRIP ==================== -->
<section class="metrics-strip">
    <div class="container">
        <div class="metrics-container">
            <div class="metric-item">
                <div class="metric-number">1,248</div>
                <div class="metric-label">Items Reported</div>
            </div>
            <div class="metric-item">
                <div class="metric-number">834</div>
                <div class="metric-label">Items Found</div>
            </div>
            <div class="metric-item">
                <div class="metric-number">392</div>
                <div class="metric-label">Returned Safely</div>
            </div>
            <div class="metric-item">
                <div class="metric-number">82%</div>
                <div class="metric-label">Successful Matches</div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== RECENTLY REPORTED ITEMS ==================== -->
<section class="py-5 my-3">
    <div class="container">
        <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
            <div>
                <h2 class="section-title">Recently reported</h2>
                <p class="section-subtitle mb-0">See what's recently been lost or found across campus.</p>
            </div>
            <a asp-controller="Items" asp-action="Index" class="btn btn-secondary btn-sm px-4">
                <span>View all listings</span>
                <i class="bi bi-arrow-right"></i>
            </a>
        </div>

        @if (Model != null && Model.Any())
        {
            <div class="row g-4">
                @foreach (var item in Model.Take(6))
                {
                    <div class="col-lg-4 col-md-6">
                        <div class="item-card">
                            <!-- Card Media Frame with Floating Badge -->
                            <div class="item-card-media">
                                @if (item.Type == BackToYou.Models.Entities.ItemType.Lost)
                                {
                                    <span class="status-badge badge-lost badge-floating">
                                        <i class="bi bi-exclamation-circle-fill"></i> Lost
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge badge-found badge-floating">
                                        <i class="bi bi-check-circle-fill"></i> Found
                                    </span>
                                }

                                @if (!string.IsNullOrEmpty(item.ImagePath))
                                {
                                    <img src="@item.ImagePath" alt="@item.Title" loading="lazy" />
                                }
                                else
                                {
                                    <div class="item-card-placeholder">
                                        <i class="bi @(item.Category?.IconClass ?? "bi-box")"></i>
                                    </div>
                                }
                            </div>

                            <!-- Card Body -->
                            <div class="item-card-body">
                                <div class="item-card-category">@(item.Category?.Name ?? "General")</div>
                                <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="item-card-title">
                                    @item.Title
                                </a>

                                <div class="item-card-meta">
                                    <div class="item-card-meta-row">
                                        <i class="bi bi-geo-alt text-muted"></i>
                                        <span>@item.Location</span>
                                    </div>
                                    <div class="item-card-meta-row">
                                        <i class="bi bi-calendar3 text-muted"></i>
                                        <span>@item.EventDate.ToString("MMM dd, yyyy")</span>
                                    </div>
                                </div>

                                <div class="item-card-footer">
                                    @{
                                        var statusClass = item.Status switch
                                        {
                                            BackToYou.Models.Entities.ItemStatus.Reported => "badge-approved",
                                            BackToYou.Models.Entities.ItemStatus.UnderClaim => "badge-pending",
                                            BackToYou.Models.Entities.ItemStatus.Claimed => "badge-found",
                                            BackToYou.Models.Entities.ItemStatus.Closed => "bg-light text-secondary border",
                                            _ => "bg-light text-dark"
                                        };
                                    }
                                    <span class="status-badge @statusClass">@item.Status</span>

                                    <a asp-controller="Items" asp-action="Details" asp-route-id="@item.Id" class="btn-card-view">
                                        <span>Details</span>
                                        <i class="bi bi-arrow-right"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 bg-white rounded-4 border">
                <i class="bi bi-inbox display-4 text-muted mb-3 d-block"></i>
                <h5 class="fw-bold">No items currently reported</h5>
                <p class="text-muted small">Check back later or file a report to help others.</p>
            </div>
        }
    </div>
</section>

<!-- ==================== CATEGORY EXPLORATION ==================== -->
<section class="py-5 bg-white border-top border-bottom">
    <div class="container">
        <div class="text-center max-w-lg mx-auto mb-5">
            <h2 class="section-title">Explore by category</h2>
            <p class="section-subtitle">Quickly filter campus listings by personal belongings category</p>
        </div>

        <div class="row row-cols-2 row-cols-md-4 row-cols-lg-4 g-3 g-lg-4">
            @if (categories != null && categories.Any())
            {
                foreach (var cat in categories)
                {
                    <div class="col">
                        <a asp-controller="Items" asp-action="Index" asp-route-categoryId="@cat.Id" class="category-pill">
                            <div class="category-pill-icon">
                                <i class="bi @(string.IsNullOrEmpty(cat.IconClass) ? "bi-box-seam" : cat.IconClass)"></i>
                            </div>
                            <div class="category-pill-name">@cat.Name</div>
                            <div class="category-pill-count">@cat.ItemCount listing@(cat.ItemCount == 1 ? "" : "s")</div>
                        </a>
                    </div>
                }
            }
            else
            {
                <div class="col">
                    <a asp-controller="Items" asp-action="Index" class="category-pill">
                        <div class="category-pill-icon"><i class="bi bi-laptop"></i></div>
                        <div class="category-pill-name">Electronics</div>
                        <div class="category-pill-count">View all</div>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="Items" asp-action="Index" class="category-pill">
                        <div class="category-pill-icon"><i class="bi bi-wallet2"></i></div>
                        <div class="category-pill-name">Wallets</div>
                        <div class="category-pill-count">View all</div>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="Items" asp-action="Index" class="category-pill">
                        <div class="category-pill-icon"><i class="bi bi-person-badge"></i></div>
                        <div class="category-pill-name">ID Cards</div>
                        <div class="category-pill-count">View all</div>
                    </a>
                </div>
                <div class="col">
                    <a asp-controller="Items" asp-action="Index" class="category-pill">
                        <div class="category-pill-icon"><i class="bi bi-key"></i></div>
                        <div class="category-pill-name">Keys</div>
                        <div class="category-pill-count">View all</div>
                    </a>
                </div>
            }
        </div>
    </div>
</section>

<!-- ==================== HOW IT WORKS ==================== -->
<section class="py-5 my-4">
    <div class="container">
        <div class="text-center mb-5">
            <h2 class="section-title">How BackToYou works</h2>
            <p class="section-subtitle">A secure, transparent 3-step loop connecting lost items with verified owners.</p>
        </div>

        <div class="row g-4">
            <!-- Step 1 -->
            <div class="col-md-4">
                <div class="how-it-works-card">
                    <div class="step-number">01</div>
                    <div class="step-icon-wrap">
                        <i class="bi bi-megaphone"></i>
                    </div>
                    <h3 class="step-title">Report</h3>
                    <p class="step-desc">
                        Post details about what you lost or found. Add campus location, date, photos, and descriptive clues.
                    </p>
                </div>
            </div>

            <!-- Step 2 -->
            <div class="col-md-4">
                <div class="how-it-works-card">
                    <div class="step-number">02</div>
                    <div class="step-icon-wrap">
                        <i class="bi bi-search"></i>
                    </div>
                    <h3 class="step-title">Connect</h3>
                    <p class="step-desc">
                        Browse real-time listings. If you recognise your belongings, submit an ownership claim with confidential proof.
                    </p>
                </div>
            </div>

            <!-- Step 3 -->
            <div class="col-md-4">
                <div class="how-it-works-card">
                    <div class="step-number">03</div>
                    <div class="step-icon-wrap">
                        <i class="bi bi-check2-circle"></i>
                    </div>
                    <h3 class="step-title">Return</h3>
                    <p class="step-desc">
                        Campus administration verifies claimant credentials and coordinates secure pickup from campus security dispatch.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- ==================== FINAL CALL TO ACTION ==================== -->
<section class="py-4 mb-5">
    <div class="container">
        <div class="cta-banner-dark">
            <div class="row align-items-center gy-4">
                <div class="col-lg-8">
                    <h2 class="cta-banner-title">Found something that isn't yours?</h2>
                    <p class="cta-banner-text">
                        Someone on campus may already be looking for it. A quick report takes under a minute and brings immense relief to a fellow student or colleague.
                    </p>
                </div>
                <div class="col-lg-4 text-lg-end">
                    <a asp-controller="Items" asp-action="Create" asp-route-type="Found" class="btn btn-hero-primary px-4 py-3">
                        <i class="bi bi-box2-heart text-success"></i> Report Found Item
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>
