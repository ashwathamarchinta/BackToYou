@model IEnumerable<BackToYou.Models.Entities.Claim>
@{
    ViewData["Title"] = "My Submitted Claims";
    var totalClaims = Model?.Count() ?? 0;
    var pendingClaims = Model?.Count(c => c.Status == BackToYou.Models.Entities.ClaimStatus.Pending) ?? 0;
    var approvedClaims = Model?.Count(c => c.Status == BackToYou.Models.Entities.ClaimStatus.Approved) ?? 0;
    var rejectedClaims = Model?.Count(c => c.Status == BackToYou.Models.Entities.ClaimStatus.Rejected) ?? 0;
}

<div class="container py-4 py-lg-5">
    <!-- Header -->
    <div class="d-flex flex-wrap justify-content-between align-items-end mb-4 gap-3">
        <div>
            <h1 class="page-title mb-1">My Submitted Claims</h1>
            <p class="section-subtitle mb-0">Track verification status and collection instructions for items you have claimed.</p>
        </div>
        <a asp-controller="Items" asp-action="Index" class="btn btn-secondary btn-sm px-4">
            <i class="bi bi-search me-1"></i> Browse Directory
        </a>
    </div>

    <!-- Summary Stat Cards -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="dashboard-stat-card">
                <span class="text-muted small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Total Claims</span>
                <div class="dashboard-stat-number">@totalClaims</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dashboard-stat-card">
                <span class="text-warning small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Pending Review</span>
                <div class="dashboard-stat-number text-warning">@pendingClaims</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dashboard-stat-card">
                <span class="text-success small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Approved Handover</span>
                <div class="dashboard-stat-number text-success">@approvedClaims</div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="dashboard-stat-card">
                <span class="text-danger small fw-semibold text-uppercase" style="letter-spacing: 0.05em;">Rejected Claims</span>
                <div class="dashboard-stat-number text-danger">@rejectedClaims</div>
            </div>
        </div>
    </div>

    @if (Model != null && Model.Any())
    {
        <div class="row g-4">
            @foreach (var claim in Model)
            {
                <div class="col-lg-6">
                    <div class="card bg-white rounded-4 border shadow-sm h-100 overflow-hidden">
                        <div class="p-3 px-4 bg-light border-bottom d-flex justify-content-between align-items-center">
                            <span class="small text-muted fw-medium">
                                Claim #@claim.Id &bull; @claim.SubmittedAt.ToString("MMM dd, yyyy")
                            </span>
                            @{
                                var statusClass = claim.Status switch
                                {
                                    BackToYou.Models.Entities.ClaimStatus.Pending => "badge-pending",
                                    BackToYou.Models.Entities.ClaimStatus.Approved => "badge-found",
                                    BackToYou.Models.Entities.ClaimStatus.Rejected => "badge-lost",
                                    _ => "bg-light text-dark"
                                };
                                var statusIcon = claim.Status switch
                                {
                                    BackToYou.Models.Entities.ClaimStatus.Pending => "bi-hourglass-split",
                                    BackToYou.Models.Entities.ClaimStatus.Approved => "bi-check-circle-fill",
                                    BackToYou.Models.Entities.ClaimStatus.Rejected => "bi-x-circle-fill",
                                    _ => "bi-info-circle"
                                };
                            }
                            <span class="status-badge @statusClass">
                                <i class="bi @statusIcon me-1"></i> @claim.Status
                            </span>
                        </div>

                        <div class="card-body p-4">
                            <!-- Linked Item Info -->
                            <div class="d-flex align-items-center gap-3 mb-3 pb-3 border-bottom">
                                @if (!string.IsNullOrEmpty(claim.Item?.ImagePath))
                                {
                                    <img src="@claim.Item.ImagePath" class="rounded-3" style="width: 52px; height: 52px; object-fit: cover;" alt="@claim.Item.Title" />
                                }
                                else
                                {
                                    <div class="rounded-3 bg-light p-2 text-muted d-flex align-items-center justify-content-center" style="width: 52px; height: 52px;">
                                        <i class="bi bi-box fs-4"></i>
                                    </div>
                                }
                                <div>
                                    <h6 class="fw-bold mb-1">
                                        <a asp-controller="Items" asp-action="Details" asp-route-id="@claim.ItemId" class="text-dark text-decoration-none">
                                            @claim.Item?.Title
                                        </a>
                                    </h6>
                                    <span class="small text-muted">
                                        <i class="bi bi-geo-alt me-1 text-danger"></i> @claim.Item?.Location &bull; @(claim.Item?.Category?.Name ?? "Item")
                                    </span>
                                </div>
                            </div>

                            <!-- Submitted Proof Description -->
                            <div class="mb-3">
                                <span class="d-block text-muted small fw-semibold mb-1">Your Submitted Proof:</span>
                                <div class="small text-secondary bg-light p-3 rounded-3 border">
                                    @claim.DescriptionProof
                                </div>
                                @if (!string.IsNullOrEmpty(claim.ProofImagePath))
                                {
                                    <a href="@claim.ProofImagePath" target="_blank" class="small text-primary text-decoration-none d-inline-flex align-items-center gap-1 mt-2">
                                        <i class="bi bi-paperclip"></i> View Attached Proof File
                                    </a>
                                }
                            </div>

                            <!-- Admin Decision Notice -->
                            @if (!string.IsNullOrEmpty(claim.AdminRemarks))
                            {
                                <div class="p-3 rounded-3 @(claim.Status == BackToYou.Models.Entities.ClaimStatus.Approved ? "bg-success bg-opacity-10 border border-success border-opacity-25" : "bg-danger bg-opacity-10 border border-danger border-opacity-25")">
                                    <span class="d-block fw-bold small mb-1 @(claim.Status == BackToYou.Models.Entities.ClaimStatus.Approved ? "text-success" : "text-danger")">
                                        <i class="bi bi-shield-check me-1"></i> Admin Verification &amp; Handover Instructions:
                                    </span>
                                    <p class="small mb-0 text-dark">
                                        @claim.AdminRemarks
                                    </p>
                                    @if (claim.ReviewedAt.HasValue)
                                    {
                                        <span class="d-block text-muted small mt-1" style="font-size: 0.75rem;">
                                            Verified on @claim.ReviewedAt.Value.ToString("MMM dd, yyyy - hh:mm tt")
                                        </span>
                                    }
                                </div>
                            }
                            else if (claim.Status == BackToYou.Models.Entities.ClaimStatus.Pending)
                            {
                                <div class="p-3 bg-light rounded-3 text-muted small border d-flex align-items-center gap-2">
                                    <i class="bi bi-info-circle text-primary fs-5"></i>
                                    <span>Under verification by campus security dispatch. You will see handover instructions once approved.</span>
                                </div>
                            }
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <div class="card bg-white rounded-4 border text-center py-5 p-4">
            <i class="bi bi-patch-question display-4 text-muted mb-3 d-block"></i>
            <h4 class="fw-bold mb-2">No ownership claims submitted yet</h4>
            <p class="text-muted small mb-4">When you spot an item in the directory that belongs to you, submit a claim to initiate verification.</p>
            <a asp-controller="Items" asp-action="Index" class="btn btn-primary btn-sm px-4">
                <i class="bi bi-search me-1"></i> Browse Campus Directory
            </a>
        </div>
    }
</div>
