@model BackToYou.Models.ViewModels.ClaimSubmitViewModel
@{
    ViewData["Title"] = "Submit Ownership Claim";
}

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <!-- Header -->
            <div class="text-center mb-4">
                <span class="hero-eyebrow mb-2">VERIFICATION PROTOCOL</span>
                <h1 class="page-title mb-2">Submit Ownership Claim</h1>
                <p class="section-subtitle">Provide verifiable details so university administrators can confirm ownership before handover.</p>
            </div>

            <!-- Form Card -->
            <div class="card p-4 p-md-5 rounded-4 border shadow-sm bg-white">
                <!-- Summary of Item Being Claimed -->
                <div class="p-3 bg-light rounded-4 mb-4 border d-flex align-items-center gap-3">
                    @if (!string.IsNullOrEmpty(Model.ItemImagePath))
                    {
                        <img src="@Model.ItemImagePath" class="rounded-3" style="width: 60px; height: 60px; object-fit: cover;" alt="@Model.ItemTitle" />
                    }
                    else
                    {
                        <div class="rounded-3 bg-white p-3 text-muted border d-flex align-items-center justify-content-center" style="width: 60px; height: 60px;">
                            <i class="bi bi-box fs-3"></i>
                        </div>
                    }
                    <div>
                        <span class="status-badge badge-found mb-1">Item to be Claimed</span>
                        <h5 class="fw-bold mb-0 text-dark">@Model.ItemTitle</h5>
                        <span class="small text-muted"><i class="bi bi-geo-alt me-1 text-danger"></i> @Model.ItemLocation &bull; Found on @Model.ItemEventDate.ToString("MMM dd, yyyy")</span>
                    </div>
                </div>

                <form asp-action="SubmitClaim" method="post" enctype="multipart/form-data">
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger p-2 small rounded-3 mb-3" role="alert"></div>
                    <input type="hidden" asp-for="ItemId" />
                    <input type="hidden" asp-for="ItemTitle" />

                    <!-- Confidential Proof Description -->
                    <div class="mb-4">
                        <label asp-for="DescriptionProof" class="form-label">Confidential Ownership Proof Details</label>
                        <textarea asp-for="DescriptionProof" rows="4" class="form-control" placeholder="Describe confidential details only the true owner would know: e.g. wallpaper pattern/hint, specific serial numbers, keychains, scratches, internal bag contents..."></textarea>
                        <span asp-validation-for="DescriptionProof" class="text-danger small"></span>
                        <div class="form-text small text-muted mt-1">
                            <i class="bi bi-shield-lock me-1 text-primary"></i> These proof details are encrypted and only accessible by authorized campus administration.
                        </div>
                    </div>

                    <!-- Supporting Document File Upload -->
                    <div class="mb-4">
                        <label asp-for="ProofFile" class="form-label">Supporting Document / Photo (Optional)</label>
                        <div class="file-dropzone position-relative">
                            <i class="bi bi-paperclip display-6 text-primary mb-2 d-block"></i>
                            <div class="fw-semibold text-dark mb-1">Upload receipt, invoice, or a previous photo with the item</div>
                            <div class="small text-muted mb-2">Supported: JPG, PNG, PDF (Max 5MB)</div>
                            <input asp-for="ProofFile" class="form-control" type="file" accept="image/*,.pdf" />
                        </div>
                        <span asp-validation-for="ProofFile" class="text-danger small"></span>
                    </div>

                    <div class="d-flex gap-3 pt-2">
                        <button type="submit" class="btn btn-primary flex-fill py-3 rounded-pill fw-semibold">
                            <i class="bi bi-send-check me-1"></i> Submit Claim for Review
                        </button>
                        <a asp-controller="Items" asp-action="Details" asp-route-id="@Model.ItemId" class="btn btn-secondary px-4 py-3 rounded-pill">
                            Cancel
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
