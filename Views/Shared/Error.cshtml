@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card p-5 rounded-4 border bg-white shadow-sm text-center">
                <i class="bi bi-exclamation-triangle text-danger display-3 mb-3 d-block"></i>
                <h1 class="page-title text-danger mb-2">Something Went Wrong</h1>
                <p class="section-subtitle mb-4">An unexpected error occurred while processing your campus request.</p>

                @if (Model.ShowRequestId)
                {
                    <div class="p-3 bg-light rounded-3 text-muted small mb-4">
                        <strong>Incident Request ID:</strong> <code>@Model.RequestId</code>
                    </div>
                }

                <div>
                    <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-house me-1"></i> Return to Safety
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>
