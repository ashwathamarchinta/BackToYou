@{
    ViewData["Title"] = "Access Denied";
}

<div class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="p-5 bg-white rounded-4 shadow-sm border">
                <i class="bi bi-shield-x display-1 text-danger mb-3 d-block"></i>
                <h1 class="page-title text-dark mb-2">Access Denied</h1>
                <p class="section-subtitle mb-4">You do not have administrative security clearance to view this page.</p>
                <a asp-controller="Home" asp-action="Index" class="btn btn-primary rounded-pill px-4">
                    <i class="bi bi-arrow-left me-1"></i> Return to Safety
                </a>
            </div>
        </div>
    </div>
</div>
