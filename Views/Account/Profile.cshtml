@model BackToYou.Models.Entities.ApplicationUser
@{
    ViewData["Title"] = "My Profile";
}

<div class="container py-4 py-lg-5">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-6">
            <div class="card shadow-sm border rounded-4 overflow-hidden bg-white">
                <!-- Profile Header -->
                <div class="p-4 text-center text-white" style="background: linear-gradient(145deg, var(--navy-950) 0%, var(--navy-900) 60%, var(--blue-800) 100%);">
                    <div class="rounded-circle bg-white mx-auto mb-3 d-inline-flex align-items-center justify-content-center fw-bold shadow-sm" style="width:72px; height:72px; color: var(--navy-950); font-size: 2rem;">
                        @((Model.FullName?[0] ?? 'U').ToString().ToUpper())
                    </div>
                    <h3 class="fw-bold mb-1" style="font-family: var(--font-serif); color: var(--ivory);">@Model.FullName</h3>
                    <span class="badge rounded-pill px-3 py-1" style="background: rgba(255, 255, 255, 0.15); color: var(--ivory);">@Model.Email</span>
                </div>

                <div class="card-body p-4 p-md-5">
                    <h6 class="text-uppercase small fw-bold text-muted mb-3" style="letter-spacing: 0.08em;">Academic &amp; Student Credentials</h6>

                    <div class="bg-light rounded-4 p-3 mb-4 border">
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small"><i class="bi bi-card-text me-2 text-primary"></i>Roll / ID Number</span>
                            <span class="fw-semibold text-dark small">@(Model.StudentRollNumber ?? "N/A")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small"><i class="bi bi-building me-2 text-primary"></i>Department</span>
                            <span class="fw-semibold text-dark small">@(Model.Department ?? "N/A")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small"><i class="bi bi-telephone me-2 text-primary"></i>Contact Phone</span>
                            <span class="fw-semibold text-dark small">@(Model.PhoneNumber ?? "N/A")</span>
                        </div>
                        <div class="d-flex justify-content-between py-2">
                            <span class="text-muted small"><i class="bi bi-calendar-check me-2 text-primary"></i>Registered Since</span>
                            <span class="fw-semibold text-dark small">@Model.CreatedAt.ToString("MMMM dd, yyyy")</span>
                        </div>
                    </div>

                    <h6 class="text-uppercase small fw-bold text-muted mb-3" style="letter-spacing: 0.08em;">Campus Portal Activity</h6>
                    <div class="row g-3 mb-4">
                        <div class="col-6">
                            <div class="dashboard-stat-card text-center p-3">
                                <span class="d-block dashboard-stat-number text-primary">@ViewBag.ReportedCount</span>
                                <span class="small text-muted fw-semibold">Reports Filed</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="dashboard-stat-card text-center p-3">
                                <span class="d-block dashboard-stat-number text-warning">@ViewBag.ClaimsCount</span>
                                <span class="small text-muted fw-semibold">Claims Submitted</span>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex gap-3">
                        <a asp-controller="Items" asp-action="MyItems" class="btn btn-primary flex-fill rounded-pill py-2">
                            <i class="bi bi-collection me-1"></i> My Listings
                        </a>
                        <a asp-controller="Claims" asp-action="MyClaims" class="btn btn-secondary flex-fill rounded-pill py-2">
                            <i class="bi bi-patch-check me-1"></i> My Claims
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
